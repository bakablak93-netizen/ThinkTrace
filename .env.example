# Local development: copy to .env (repo root) and fill in. Never commit .env.
# On hosting (Render etc.) do NOT upload a .env file: set these as environment
# variables in the hosting dashboard. Everything works without any of them.

# --- LLM (stage 2, not used by the code yet). Without a key: offline templates. ---
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# --- Storage ---
# SQLite file. Locally the path is relative to backend/.
# In the Docker image the default is /app/data/thinktrace.sqlite3.
DATABASE_PATH=thinktrace.sqlite3

# --- Public demo protection (endpoints that will call the LLM: steps, hint, report) ---
RATE_LIMIT_PER_SESSION=300
RATE_LIMIT_PER_DAY=5000

# --- Optional ---
# Where the built frontend is served from (default: frontend/dist).
# STATIC_DIR=
# CORS origin for running the frontend on a separate origin (not needed with the Vite proxy).
FRONTEND_ORIGIN=http://localhost:5173
# PORT is set by the hosting platform; the Docker image defaults to 10000.
